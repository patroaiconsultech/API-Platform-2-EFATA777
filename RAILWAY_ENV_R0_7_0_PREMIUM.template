# ORKIO BACKEND R0.7.0 PREMIUM — RAILWAY TEMPLATE
# Replace every <PLACEHOLDER>. Never commit real secrets.

# ─────────────────────────────────────────────────────────────
# RUNTIME / RELEASE
# ─────────────────────────────────────────────────────────────
PLATFORM_ENVIRONMENT=production
PORT=8080
PLATFORM_API_TITLE=ORKIO Plataforma 2.0 Premium R0.7.0
PLATFORM_RELEASE_SHA=<DEPLOYED_BACKEND_COMMIT_SHA>
PLATFORM_DOCS_ENABLED=false
PLATFORM_REQUEST_LOG_ENABLED=true
PLATFORM_DATABASE_ECHO=false

# ─────────────────────────────────────────────────────────────
# NETWORK / DATABASE
# ─────────────────────────────────────────────────────────────
PLATFORM_ALLOWED_ORIGINS=<FRONTEND_PUBLIC_HTTPS_ORIGIN>
DATABASE_URL=<RAILWAY_POSTGRES_DATABASE_URL>
PLATFORM_EXECUTION_LEASE_SECONDS=60
PLATFORM_EXECUTION_STALE_AFTER_SECONDS=300

# ─────────────────────────────────────────────────────────────
# AUTH — APPLY ALL OIDC VALUES BEFORE oidc_introspection
# ─────────────────────────────────────────────────────────────
PLATFORM_AUTH_MODE=oidc_introspection
PLATFORM_OIDC_ISSUER=<OIDC_ISSUER_HTTPS_URL>
PLATFORM_OIDC_AUDIENCE=orkio-api
PLATFORM_OIDC_AUTHORIZATION_ENDPOINT=<OIDC_AUTHORIZATION_HTTPS_URL>
PLATFORM_OIDC_TOKEN_ENDPOINT=<OIDC_TOKEN_HTTPS_URL>
PLATFORM_OIDC_INTROSPECTION_ENDPOINT=<OIDC_INTROSPECTION_HTTPS_URL>
PLATFORM_OIDC_PUBLIC_CLIENT_ID=<OIDC_PUBLIC_CLIENT_ID>
PLATFORM_OIDC_INTROSPECTION_CLIENT_ID=<OIDC_INTROSPECTION_CLIENT_ID>
PLATFORM_OIDC_INTROSPECTION_CLIENT_SECRET=<OIDC_INTROSPECTION_CLIENT_SECRET>
PLATFORM_OIDC_REDIRECT_URI=<FRONTEND_PUBLIC_HTTPS_ORIGIN>
PLATFORM_OIDC_SCOPES=openid,profile,email
PLATFORM_OIDC_USER_CLAIM=sub
PLATFORM_OIDC_TENANT_CLAIM=tenant_id
PLATFORM_OIDC_ROLES_CLAIM=roles
PLATFORM_OIDC_ADMIN_ROLES=orkio_admin
PLATFORM_OIDC_MEMBER_ROLES=orkio_member
PLATFORM_OIDC_CLOCK_SKEW_SECONDS=30
PLATFORM_OIDC_HTTP_TIMEOUT_SECONDS=5
PLATFORM_OIDC_CACHE_SECONDS=15

# ─────────────────────────────────────────────────────────────
# LLM
# ─────────────────────────────────────────────────────────────
PLATFORM_LLM_PROVIDER=openai_responses
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_DEFAULT_MODEL=<APPROVED_OPENAI_MODEL>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_STORE_RESPONSES=false
PLATFORM_LLM_HISTORY_MESSAGES=20
PLATFORM_LLM_MAX_CONTEXT_CHARS=100000
# OPENAI_ORGANIZATION_ID=<OPTIONAL_OPENAI_ORGANIZATION_ID>
# OPENAI_PROJECT_ID=<OPTIONAL_OPENAI_PROJECT_ID>

# ─────────────────────────────────────────────────────────────
# TEXT REALTIME / MULTIAGENT
# ─────────────────────────────────────────────────────────────
PLATFORM_REALTIME_STREAMING_ENABLED=true
PLATFORM_MULTIAGENT_ENABLED=true
PLATFORM_MULTIAGENT_MAX_CONTRIBUTORS=2
PLATFORM_MULTIAGENT_TEAM_AGENTS=Orion,Chris,Laura
PLATFORM_MULTIAGENT_CONTRIBUTION_MAX_CHARS=4000
PLATFORM_MULTIAGENT_CONTRIBUTION_MAX_OUTPUT_TOKENS=900
PLATFORM_MULTIAGENT_OWNER_MAX_OUTPUT_TOKENS=1200
PLATFORM_MULTIAGENT_CONTRIBUTION_LATENCY_BUDGET_MS=15000
PLATFORM_MULTIAGENT_TURN_LATENCY_BUDGET_MS=25000
PLATFORM_MULTIAGENT_HISTORY_MESSAGES=4
PLATFORM_MULTIAGENT_MAX_CONTEXT_CHARS=20000
PLATFORM_MULTIAGENT_TURN_MAX_TOTAL_TOKENS=7000
PLATFORM_ASSISTED_EVOLUTION_ENABLED=false

# ─────────────────────────────────────────────────────────────
# VOICE — SAFE DEPLOY DEFAULT
# Set PLATFORM_REALTIME_VOICE_ENABLED=true only after migration 005,
# provider retention confirmation, browser/WebRTC smoke, and rollback proof.
# ─────────────────────────────────────────────────────────────
PLATFORM_REALTIME_VOICE_ENABLED=false
PLATFORM_VOICE_PROVIDER=disabled
PLATFORM_VOICE_ACTIONS_ENABLED=false
PLATFORM_MULTIAGENT_VOICE_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
PLATFORM_VOICE_MAX_SESSION_SECONDS=1800
PLATFORM_VOICE_IDLE_TIMEOUT_SECONDS=120
PLATFORM_VOICE_MAX_RECONNECT_ATTEMPTS=3
PLATFORM_VOICE_RECONNECT_DEADLINE_SECONDS=30
PLATFORM_VOICE_RESUME_TOKEN_TTL_SECONDS=120
PLATFORM_VOICE_RESUME_TOKEN_SECRET=<RANDOM_SECRET_MINIMUM_32_CHARACTERS>
PLATFORM_VOICE_MAX_ACTIVE_SESSIONS_PER_USER=1
PLATFORM_VOICE_RAW_AUDIO_RETENTION=none
PLATFORM_VOICE_TRANSCRIPT_RETENTION=thread_policy
PLATFORM_VOICE_PROVIDER_RETENTION_CONFIRMED=false
PLATFORM_VOICE_CONSENT_REQUIRED=true
PLATFORM_VOICE_AUDIT_CONTENT=metadata_only
PLATFORM_VOICE_LOG_TRANSCRIPT_CONTENT=false

# ─────────────────────────────────────────────────────────────
# GITHUB READONLY PREMIUM — BACKEND ONLY
# ─────────────────────────────────────────────────────────────
PLATFORM_GITHUB_INTEGRATION_ENABLED=true
PLATFORM_GITHUB_READ_ONLY=true
PLATFORM_GITHUB_AUTH_MODE=github_app
PLATFORM_GITHUB_APP_ID=<GITHUB_APP_ID>
PLATFORM_GITHUB_APP_INSTALLATION_ID=<GITHUB_APP_INSTALLATION_ID>
PLATFORM_GITHUB_APP_PRIVATE_KEY_B64=<BASE64_PEM_PRIVATE_KEY>
PLATFORM_GITHUB_API_BASE_URL=https://api.github.com
PLATFORM_GITHUB_API_VERSION=2026-03-10
PLATFORM_GITHUB_ALLOWED_REPOSITORIES=patroaiconsultech/ORKIO_FRONTEND_AO67L_CONSOLIDATED_RC_FULL,patroaiconsultech/ORKIO_BACKEND_AO67K_CONSOLIDATED_RC_FULL
PLATFORM_GITHUB_DEFAULT_REF=main
PLATFORM_GITHUB_ALLOWED_ROLES=admin
PLATFORM_GITHUB_ALLOWED_TENANTS=<AUTHORIZED_TENANT_ID>
PLATFORM_GITHUB_ALLOWED_USERS=<AUTHORIZED_ADMIN_USER_ID>
PLATFORM_GITHUB_ORION_AUTO_AUDIT_ENABLED=true
PLATFORM_GITHUB_HTTP_TIMEOUT_SECONDS=20
PLATFORM_GITHUB_AUDIT_DEADLINE_SECONDS=60
PLATFORM_GITHUB_MAX_RESPONSE_BYTES=8000000
PLATFORM_GITHUB_MAX_TREE_ENTRIES=5000
PLATFORM_GITHUB_MAX_FILES_PER_AUDIT=24
PLATFORM_GITHUB_MAX_FILE_BYTES=250000
PLATFORM_GITHUB_MAX_TOTAL_CHARS=80000
PLATFORM_GITHUB_ALLOW_METADATA_READ=true
PLATFORM_GITHUB_ALLOW_CONTENT_READ=true
PLATFORM_GITHUB_ALLOW_DIFF_READ=true
PLATFORM_GITHUB_ALLOW_WRITE=false
